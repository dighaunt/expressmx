{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"],
      "env": [
        "NODE_ENV",
        "DATABASE_URL",
        "DATABASE_POOL_MAX",
        "DATABASE_POOL_IDLE_TIMEOUT",
        "JWT_SECRET",
        "JWT_EXPIRES_IN",
        "REFRESH_TOKEN_SECRET",
        "RESEND_API_KEY",
        "EMAIL_FROM",
        "NEXT_PUBLIC_APP_URL",
        "STRIPE_SECRET_KEY",
        "STRIPE_WEBHOOK_SECRET",
        "NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY",
        "STRIPE_PUBLISHABLE_KEY"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "dev:clear": {
      "cache": false,
      "persistent": true
    },
    "dev:tunnel": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "test": {
      "dependsOn": ["^build"],
      "inputs": ["src/**/*.{ts,tsx}", "test/**/*.{ts,tsx}"],
      "outputs": ["coverage/**"],
      "env": [
        "NODE_ENV",
        "DATABASE_URL",
        "JWT_SECRET",
        "REFRESH_TOKEN_SECRET"
      ]
    },
    "e2e": {
      "dependsOn": ["^build"],
      "cache": false,
      "env": ["E2E_BASE_URL", "E2E_ADMIN_EMAIL", "E2E_ADMIN_PASSWORD", "E2E_ADMIN_AVAILABLE", "E2E_NO_WEBSERVER", "DATABASE_URL", "JWT_SECRET"]
    },
    "typecheck": {
      "dependsOn": ["^typecheck"]
    },
    "db:apply-schema": {
      "cache": false
    }
  }
}
